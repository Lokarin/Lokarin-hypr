{
  "$schema": "https://github.com/Alexays/Waybar/raw/master/resources/config.schema.json",

  // ============================================================
  // GERAL
  // ============================================================

  "layer": "top",
  "position": "top",
  "height": 35,
  "margin-top": 0,


  // ============================================================
  // POSIÇÃO DOS MÓDULOS
  // ============================================================

  "modules-left": [
    "custom/espaco",
    "custom/cpu",
    "custom/memoria",
    "custom/tasks",
    "custom/gpu",
    "pulseaudio"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "custom/cmus",
    "custom/bateria",
    "tray",
    "custom/calendario"
  ],


  // ============================================================
  // WORKSPACES
  // ============================================================

  "hyprland/workspaces": {
    "active-only": false,
    "all-outputs": true,
    "disable-scroll": false,

    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",

    "on-click": "activate",

    "format": "{icon}",

    "format-icons": {
      "urgent": " ",
      "active": " ",
      "default": "󰧞 "
    },

    "sort-by-number": true
  },


  // ============================================================
  // ÁUDIO
  // ============================================================

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": " ",
    "on-click": "pavucontrol"
  },


  // ============================================================
  // MÓDULOS PERSONALIZADOS
  // ============================================================

  "custom/espaco": {
    "exec": "~/Documentos/scripts/disk.sh",
    "interval": 60,
    "return-type": "text",
    "format": "  {}"
  },

  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu.sh",
    "interval": 1,
    "return-type": "text"
  },

  "custom/memoria": {
    "exec": "~/Documentos/scripts/memBlock.sh",
    "interval": 5,
    "return-type": "text",
    "on-click": "notify-send \"$(ps axch -o cmd:15,%mem --sort=-%mem | head)\"",
    "format": "  {}"
  },

  "custom/tasks": {
    "exec": "~/Documentos/scripts/nTasks.sh",
    "interval": 5,
    "return-type": "text",
    "format": "  {}"
  },

  "custom/gpu": {
    "exec": "~/Documentos/scripts/gpuBlock.sh",
    "interval": 2,
    "return-type": "text",
    "format": "󰍹  {}"
  },

  "custom/cmus": {
    "exec": "~/Documentos/scripts/cmusPlaying.sh",
    "interval": 1,
    "return-type": "text"
  },

  "custom/bateria": {
    "exec": "~/Documentos/scripts/bateria.sh",
    "interval": 5,
    "return-type": "text",
    //"format": "  {}"
    "format": "{}"
  },

  "custom/calendario": {
    "exec": "~/Documentos/scripts/dataBlockPolybar.sh",
    "interval": 30,
    "on-click": "notify-send \"$(cal)\"",
    "return-type": "text"
  },
}
